<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_activity_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black">

    <!-- 1. Video Container (Top in portrait, full in landscape) -->
    <FrameLayout
        android:id="@+id/video_root_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/black">

        <LinearLayout
            android:id="@+id/video_surface_wrapper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:id="@+id/status_bar_filler"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="@android:color/black"
                android:visibility="visible" />

            <FrameLayout
                android:id="@+id/player_media_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/black">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/player_exoplayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:use_controller="false"
                    android:visibility="visible" />

            </FrameLayout>

            <View
                android:id="@+id/bottom_gap_filler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@android:color/black"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The Invisible Shield / Touch Wall -->
        <View
            android:id="@+id/touch_wall"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- Seek Indicators -->
        <TextView
            android:id="@+id/indicator_rewind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="32dp"
            android:background="@drawable/indicator_pill_bg"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="◄◄ 10s"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/indicator_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="32dp"
            android:background="@drawable/indicator_pill_bg"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="10s ►►"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/indicator_2x"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/indicator_pill_bg"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="2.0x SPEED ⏩"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Volume/Brightness Indicators -->
        <TextView
            android:id="@+id/indicator_volume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="64dp"
            android:background="@drawable/indicator_pill_bg"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="🔊 100%"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/indicator_brightness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="64dp"
            android:background="@drawable/indicator_pill_bg"
            android:paddingStart="18dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp"
            android:text="☀️ 100%"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Native Control Overlay -->
        <RelativeLayout
            android:id="@+id/controls_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#59000000"
            android:visibility="visible">

            <!-- Top bar -->
            <RelativeLayout
                android:id="@+id/top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/video_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/btn_pip"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Now Playing"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:shadowColor="@android:color/black"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_captions"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_toStartOf="@id/btn_settings"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="2dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_cc"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_pip"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_toStartOf="@id/btn_captions"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="2dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="@android:color/white" />
            </RelativeLayout>

            <!-- Center buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btn_prev_episode"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="10dp"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_rewind"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="14dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_rew"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_forward"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="14dp"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_ff"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/btn_next_episode"
                    android:layout_width="41dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- Scrubber Preview -->
            <LinearLayout
                android:id="@+id/scrubber_preview_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/bottom_bar"
                android:layout_marginBottom="28dp"
                android:background="@drawable/indicator_pill_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/scrubber_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:shadowColor="@android:color/black"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3" />
            </LinearLayout>

            <!-- Bottom bar -->
            <LinearLayout
                android:id="@+id/bottom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <SeekBar
                    android:id="@+id/video_seekbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="0dp"
                    android:thumbTint="@android:color/white" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingHorizontal="4dp">
                    
                    <TextView
                        android:id="@+id/text_current_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="00:00"
                        android:textColor="@android:color/white"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/time_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/btn_fullscreen_toggle"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="4dp"
                        android:orientation="horizontal">
                        
                        <TextView
                            android:id="@+id/text_time_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-00:00"
                            android:textColor="#CCCCCC"
                            android:textSize="11sp"
                            android:layout_marginEnd="2dp" />
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/"
                            android:textColor="#999999"
                            android:textSize="11sp"
                            android:layout_marginEnd="2dp" />
                            
                        <TextView
                            android:id="@+id/text_total_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@android:color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_fullscreen_toggle"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_zoom"
                        app:tint="@android:color/white" />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Independent Skip Intro/Outro Button (Stays visible even when controls hide) -->
        <TextView
            android:id="@+id/btn_skip_intro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_marginBottom="60dp"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="⏭️ Skip Intro"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:elevation="20dp"
            android:translationZ="20dp"
            android:visibility="gone" />

        <!-- Independent Auto-Next Episode Countdown Toast -->
        <LinearLayout
            android:id="@+id/layout_auto_next_toast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_marginBottom="60dp"
            android:layout_marginStart="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/indicator_pill_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:elevation="20dp"
            android:translationZ="20dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/auto_next_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/text_auto_next_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next in 10s"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_auto_next_play_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/speed_btn_bg"
                android:text="Play Now"
                android:textColor="#818CF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btn_auto_next_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:text="✕"
                android:textColor="#A0A0A0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Native Subtitle Overlay (Outside controls_overlay so captions stay visible when controls hide) -->
        <TextView
            android:id="@+id/text_native_subtitle_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="42dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="@android:color/black"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:elevation="10dp"
            android:translationZ="10dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/loading_progress"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="visible" />

    </FrameLayout>

    <!-- 2. Half-screen Bottom Area in Portrait (Dark background - used only in offline playback) -->
    <LinearLayout
        android:id="@+id/portrait_bottom_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#0B0B0E"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/portrait_anime_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anime Title"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/portrait_episode_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Episode 1"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#222228" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/portrait_badge_hd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1F1F2C"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="1080p HD"
                android:textColor="#818cf8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/portrait_badge_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#1F1F2C"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ENG DUB"
                android:textColor="#34d399"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tap the fullscreen button or rotate your device to watch in full landscape."
            android:textColor="#666677"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
